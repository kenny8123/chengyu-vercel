# Copy this file to .env.local and fill in your own key.
# .env.local is git-ignored and is only read by scripts/generate-idiom.mjs
# (a local content-authoring tool) — it is never bundled into the website.
#
# Get a key at https://console.anthropic.com/settings/keys
# If you previously pasted a key into a chat, terminal, or Claude conversation,
# treat it as compromised: revoke it there and generate a fresh one for this file.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the model used for content generation (defaults to claude-sonnet-5)
# ANTHROPIC_MODEL=claude-sonnet-5
